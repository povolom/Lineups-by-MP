// Cloudflare Worker settings for lineups.marcantoniopovolo.com (static files from site/, no Worker code).
{
  "name": "lineups-by-mp",
  "compatibility_date": "2026-10-03",
  "assets": { "directory": "./site" },
  // Cloudflare creates the DNS record and HTTPS certificate for this subdomain on deploy.
  "routes": [{ "pattern": "lineups.marcantoniopovolo.com", "custom_domain": true }]
}
