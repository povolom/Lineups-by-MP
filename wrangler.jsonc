// Cloudflare Worker settings for lineups.marcantoniopovolo.com.
// site/ is the website; worker.js answers /api/ (everything that isn't a file in site/ reaches the Worker).
{
  "name": "lineups-by-mp",
  "main": "worker.js",
  "compatibility_date": "2026-10-03",
  "assets": { "directory": "./site", "binding": "ASSETS" },
  // Cloudflare creates the DNS record and HTTPS certificate for this subdomain on deploy.
  "routes": [{ "pattern": "lineups.marcantoniopovolo.com", "custom_domain": true }]
}
